{{!
    @template local_stripe/subscription_account

    User-facing subscription status and billing actions.
}}
<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex flex-column flex-sm-row align-items-sm-start justify-content-between mb-3">
                    <div class="d-flex align-items-center mb-3 mb-sm-0">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light text-primary mr-3"
                              style="width: 3rem; height: 3rem;" aria-hidden="true">
                            <i class="fa fa-credit-card fa-lg"></i>
                        </span>
                        <h2 class="h3 mb-0">{{title}}</h2>
                    </div>
                    <span class="badge {{statusclass}} px-3 py-2">
                        <i class="fa {{statusicon}} mr-1" aria-hidden="true"></i>{{status}}
                    </span>
                </div>

                <p class="text-muted mb-4">{{description}}</p>

                {{#billingmissing}}
                    <div class="alert alert-warning mb-4" role="alert">
                        <i class="fa fa-exclamation-triangle mr-2" aria-hidden="true"></i>{{billingmissingmessage}}
                    </div>
                {{/billingmissing}}

                {{#canmanage}}
                    <div class="border rounded p-3 p-md-4 bg-light">
                        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between">
                            <div class="mr-md-4 mb-3 mb-md-0">
                                <div class="font-weight-bold mb-1">{{secureportal}}</div>
                                <div class="small text-muted">{{managedescription}}</div>
                            </div>
                            <a href="{{manageurl}}" class="btn btn-primary text-nowrap">
                                <i class="fa fa-external-link mr-2" aria-hidden="true"></i>{{managelabel}}
                            </a>
                        </div>
                    </div>
                {{/canmanage}}

                {{^hasaccess}}
                    <div class="mt-4">
                        <a href="{{plansurl}}" class="btn {{#hascustomer}}btn-outline-primary{{/hascustomer}}{{^hascustomer}}btn-primary{{/hascustomer}}">
                            <i class="fa fa-star mr-2" aria-hidden="true"></i>{{planslabel}}
                        </a>
                    </div>
                {{/hasaccess}}
            </div>
        </div>
    </div>
</div>
